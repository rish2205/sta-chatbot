# Copy this file to .streamlit/secrets.toml and fill in your key.
# Never commit secrets.toml.
OPENAI_API_KEY = "sk-..."

# Local MySQL (company list). Replace the placeholders; never commit the real file.
DB_HOST = "127.0.0.1"
DB_PORT = 3306
DB_USER = "your-mysql-user"
DB_PASSWORD = "your-mysql-password"
DB_NAME = "details"

# Local test only: enables the unauthenticated folio lookup (loopback clients). Omit in production.
# FOLIO_LOOKUP_MODE = "local_test"

# Optional: override the models (your key must have access to them)
# SCOPE_MODEL  = "gpt-4.1-mini"
# ANSWER_MODEL = "gpt-4.1"

# Email OTP
# OTP_TEST_MODE = true   # true: OTP goes to OTP_TEST_TO_EMAIL; false: to the folio's folio_mail_id
# OTP_FROM_EMAIL = "sender@example.com"
# OTP_TEST_TO_EMAIL = "tester@example.com"
# OTP_EXPIRY_SECONDS = 60   # 600 later
# OTP_MAX_RESENDS = 3
# OTP_MAX_SENDS_PER_HOUR = 10
# OTP_AUTH_TTL_SECONDS = 900
# OTP_HMAC_KEY = "at least 32 random chars"
# SMTP_HOST = ""
# SMTP_PORT = 587
# SMTP_USER = ""
# SMTP_PASSWORD = ""
